# Local development uses the Vite proxy to http://localhost:5000/api.
# Set the production Vercel variable to the Render API base URL ending in /api.
VITE_API_URL=http://localhost:5000/api
VITE_API_RETRY_COUNT=3
VITE_API_RETRY_BASE_DELAY_MS=1000
VITE_API_RETRY_MAX_DELAY_MS=8000
VITE_API_TIMEOUT_MS=65000
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com